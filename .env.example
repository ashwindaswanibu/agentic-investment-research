# Safe initial state. Research runs require explicit provider and operator setup.
RESEARCHDESK_READ_ONLY=true
RESEARCHDESK_PROVIDER=disabled
RESEARCHDESK_MODEL=
RESEARCHDESK_OPENAI_API_KEY=
RESEARCHDESK_OPERATOR_TOKEN=

# Used by native Python processes. Compose supplies its own PostgreSQL service URL.
RESEARCHDESK_DATABASE_URL=sqlite:///./data/researchdesk.db
RESEARCHDESK_PROVIDER_TIMEOUT_SECONDS=120
RESEARCHDESK_MAX_TURNS=20
RESEARCHDESK_CLAUDE_BINARY=claude
RESEARCHDESK_DOCKER_BINARY=docker
RESEARCHDESK_SANDBOX_IMAGE=researchdesk-sandbox:local
RESEARCHDESK_SANDBOX_TIMEOUT_SECONDS=20
RESEARCHDESK_RETRIEVAL_MODE=lexical
RESEARCHDESK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_HUB_DISABLE_IMPLICIT_TOKEN=1

# Compose requires a nonempty unique password; generate hexadecimal secrets.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8010
WEB_PORT=3000
DOCKER_SOCKET_PATH=/var/run/docker.sock
RESEARCHDESK_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8010,http://localhost:8010
RESEARCH_ALLOWED_ORIGINS=

# Optional read-only market-data access for the separate paper worker.
# Keep these on the worker; the API/frontend do not need market credentials.
RESEARCHDESK_ALPACA_API_KEY=
RESEARCHDESK_ALPACA_SECRET_KEY=
RESEARCHDESK_ALPACA_FEED=iex
